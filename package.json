{
  "name": "expert-ai-agent",
  "version": "0.1.6",
  "description": "Expert AI Agent - lightweight tray app that pairs this machine with the Expert AI Chat phone app and runs the Pi agent locally, relayed over Cloudflare.",
  "main": "main/index.js",
  "type": "commonjs",
  "author": "ssv.asia",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --remote-debugging-port=9223",
    "setup:binaries": "node scripts/setup-binaries.js",
    "update:pi": "node scripts/update-pi-engine.js",
    "build": "npm ci && node scripts/setup-binaries.js && electron-builder --publish=never",
    "build:win": "set ELECTRON_BUILDER_COMPRESSION_LEVEL=5 && npm ci && node scripts/setup-binaries.js && electron-builder --win --publish=never",
    "build:mac": "npm ci && node scripts/setup-binaries.js && electron-builder --mac --publish=never",
    "build:store": "npm ci && node scripts/setup-binaries.js && node scripts/build-store-package.js",
    "build:linux": "npm ci && node scripts/setup-binaries.js && electron-builder --linux --publish=never",
    "test": "node --test test/tunnel-timeout.test.js"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "electron": "^42.4.1",
    "electron-builder": "^24.9.1",
    "typebox": "^1.1.38"
  },
  "build": {
    "appId": "asia.ssv.expert-ai-agent",
    "productName": "Expert AI Agent",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/expert-ai-owl-enlarged-transparent.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/expert-ai-owl-enlarged-transparent.png",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Expert AI Agent runs a local server so your paired phone can connect."
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/expert-ai-owl-enlarged-transparent.png",
      "category": "Utility"
    }
  },
  "directories": {
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssv-asia/expert-ai-tray.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/ssv-asia/expert-ai-tray/issues"
  },
  "homepage": "https://github.com/ssv-asia/expert-ai-tray#readme"
}
