# App's own dependency tree (also catches nested node_modules in leftover
# backup dirs). The bundled pi runtime under resources/pi-node/ is re-included
# at the bottom.
node_modules/

# ---------------------------------------------------------------------------
# ANCHOR these to the repo root (leading /). An un-anchored `build/` or `dist/`
# ALSO matches those same dir names nested deep inside
# resources/pi-node/node_modules/ — transitive deps ship compiled code under
# build//dist/ — which silently dropped ~4200 real runtime files from git and
# gave fresh-clone / CI builds a broken pi engine.
# ---------------------------------------------------------------------------
/dist/
/out/
/build/*
!/build/installer.nsh

*.log
.DS_Store
.env
.env.local
.env.*.local
*.tsbuildinfo
*.dmg
*.deb
.pnpm-debug.log

# Native/Windows binaries: ignored by default, except the ones we ship.
*.exe
!resources/pi-server.exe
!resources/pi-server

# Leftover local dirs — never part of a build, safe to delete, must never be
# committed.
/.pi-node-bak-DELETE-ME/
/mac-builds/

# ---------------------------------------------------------------------------
# The bundled pi engine — portable Node + @earendil-works/pi-coding-agent — is a
# self-contained runtime the packaged app spawns as a subprocess
# (main/pi-server.js bundledPiBinary()/bundledNodeBinary()). It MUST be committed
# in full or a fresh clone / GitHub Actions build ships an app whose Agent mode
# can't start. Re-include everything under it that any rule above would drop.
# ---------------------------------------------------------------------------
!resources/pi-node/**
!resources/pi-node/node_modules/**
